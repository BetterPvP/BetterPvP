          "refId": "pod"
        },
        "definition": "label_values(bpvp_server_players{role=~\"$role\",server=~\"$server\"}, pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
